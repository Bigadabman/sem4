<UserControl x:Class="LibraryApp.Views.AuthorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryApp.ViewModels">
    <UserControl.DataContext>
        <vm:AuthorsViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="200" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Поиск" Command="{Binding SearchCommand}" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Command="{Binding EditCommand}" Margin="0,0,10,0" IsEnabled="{Binding SelectedAuthor, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedAuthor, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Автор" Binding="{Binding Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>