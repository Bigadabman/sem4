<UserControl x:Class="LibraryApp.Views.BookLoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryApp.ViewModels">
    <UserControl.DataContext>
        <vm:BookLoansViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox Width="200" Margin="0,0,10,0" ItemsSource="{Binding Books}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedBook}" />
            <ComboBox Width="200" Margin="0,0,10,0" ItemsSource="{Binding Readers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedReader}" />
            <Button Content="Выдать" Command="{Binding LoanCommand}" Margin="0,0,10,0"/>
            <Button Content="Вернуть" Command="{Binding ReturnCommand}" Margin="0,0,10,0" IsEnabled="{Binding SelectedBookLoan, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding BookLoans}" SelectedItem="{Binding SelectedBookLoan, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Книга" Binding="{Binding Book.Title}" Width="*"/>
                <DataGridTextColumn Header="Читатель" Binding="{Binding Reader.Name}" Width="*"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding LoanDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>