<UserControl x:Class="LibraryApp.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LibraryApp.ViewModels"
             xmlns:local="clr-namespace:LibraryApp.Views"
             x:Name="BooksViewControl">
    <UserControl.DataContext>
        <vm:BooksViewModel />
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Width="200" Margin="0,0,10,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Поиск..." />
            <Button Content="Поиск" Command="{Binding SearchCommand}" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Command="{Binding EditCommand}" Margin="0,0,10,0" IsEnabled="{Binding SelectedBook, Converter={StaticResource NullToBoolConverter}}"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedBook, Converter={StaticResource NullToBoolConverter}}"/>
        </StackPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="80"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author.Name}" Width="150"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre.Name}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>