<Window x:Class="LibraryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LibraryApp.Views"
        Title="Библиотека" Height="500" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Книги">
                <views:BooksView />
            </TabItem>
            <TabItem Header="Авторы">
                <views:AuthorsView />
            </TabItem>
            <TabItem Header="Жанры">
                <views:GenresView />
            </TabItem>
            <TabItem Header="Читатели">
                <views:ReadersView />
            </TabItem>
            <TabItem Header="Выдача">
                <views:BookLoansView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>