<Window 
    Icon="D:\bstu\sem 4\OOP\Code\Lab04-05\Lab04-05\bin\Debug\Resources\icon.png"
Cursor="D:\bstu\sem 4\OOP\Code\Lab04-05\Lab04-05\bin\Debug\Resources\Kitty normal.ani"
       
        x:Class="Lab04_05.addRecipe"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab04_05"
        mc:Ignorable="d"
        Height="600"
        Title="Создание рецепта" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
  
    
    <ScrollViewer
    VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" 
    >
        <Grid Background="#f5f5f5f5" >
            <Border Margin="40">
          
                <StackPanel>
                <TextBox Opacity="0.6"  
                    x:Name="RecipeName" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                    <Image x:Name="RecipeImage" 
           Width="300" 
           Height="300" 
           Margin="0,10"
           Stretch="Uniform"/>

                    <Button Content="Загрузить фото" 
        Click="LoadImage_Click" 
        Width="120"
        Margin="0,10"/>
                    <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="Количество порций" FontSize="16"></Label>
                        <Grid Width="150" Height="50" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Click="PortionCounterMinus_Click" x:Name="PortionCounterMinus"  Grid.Column="0" Content="-" IsEnabled="False" />
                            <Label x:Name="PortionCounter"
                                Grid.Column="1" Content="0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"  />
                            <Button Click="PortionCounterPlus_Click" x:Name="PortionCounterPlus" Grid.Column="2" Content="+" HorizontalAlignment="Right" Width="50" />
                        </Grid>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right">
                        <Label Content="Время приготовления" FontSize="16"></Label>
                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

 
                                <xctk:IntegerUpDown x:Name="hours" Value="0"
                                    Minimum="0" Maximum="23" Width="80" Grid.Column="0"/>
                               
                            <Label FontSize="16" Grid.Column="1" VerticalAlignment="Center">Часов</Label>
                                <xctk:IntegerUpDown x:Name="minutes" Value="0"
                                    Minimum="0" Maximum="59" Width="80" Grid.Column="2"/>
                                
                            <Label FontSize="16" Grid.Column="3" VerticalAlignment="Center">Минут</Label>
                        </Grid>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="IngredientList">
                    <Label FontSize="20" FontWeight="Bold">Ингредиенты</Label>
                    

                    <Button x:Name="addIngredient" FontSize="16" HorizontalAlignment="Center" Click="addIngredient_Click">+ Добавить ингредиент</Button>
                </StackPanel>

                <StackPanel x:Name="Steps">
                    <Label FontSize="20" FontWeight="Bold">Шаги</Label>
                    
                    

                    <Button x:Name="addStep" FontSize="16" HorizontalAlignment="Center" Click="addStep_Click">+ Добавить шаг</Button>
                    
                </StackPanel>


                <Label FontSize="20" FontWeight="Bold">Описание</Label>
                <TextBox x:Name="Description"
                    
                         Height="100"></TextBox>

                <Button x:Name="SaveRecipe"
                    Content="Сохранить" 
                        HorizontalAlignment="Right"
                        Height="30" Width="100"
                        Click="SaveRecipe_Click"
                        />
            </StackPanel>
            
            
            
            
            
        </Border>

        
    </Grid>
        </ScrollViewer>
   
</Window>
