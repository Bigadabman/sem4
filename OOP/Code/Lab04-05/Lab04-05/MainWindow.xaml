<Window x:Class="Lab04_05.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab04_05"
        mc:Ignorable="d"
       
        Title="{DynamicResource AppTitle}"
        Height="450" 
        Width="800">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FilterHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0 10 0 5"/>
        </Style>
    </Window.Resources>
                            
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Кнопка переключения языка -->
        <Button x:Name="LanguageButton" 
                Content="{DynamicResource LanguageButtonText}"
                Click="LanguageButton_Click"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5"
                Width="80"/>

        

        <StackPanel x:Name="Filters" Grid.Column="0" Margin="10">
            
            <TextBlock Text="{DynamicResource SearchRecipes}" Style="{StaticResource FilterHeader}"/>
            <TextBox x:Name="SearchBox" 
                     Margin="0 0 0 15"
                     Padding="5"
                     TextChanged="SearchBox_TextChanged"/>

            <TextBlock Text="{DynamicResource MaxCookingTime}" />
            <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                <TextBox x:Name="MaxTime" 
                         Width="60"
                         Margin="0 0 5 0"
                         TextChanged="MaxTime_TextChanged"/>
                <TextBlock Text="{DynamicResource Minutes}" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="CreateRecipe" 
                    Click="CreateRecipe_Click" 
                    Content="{DynamicResource CreateRecipeButton}" 
                    Margin="0 20 0 0"
                    Padding="10 5"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>

        <ScrollViewer Grid.ColumnSpan="2" Grid.Column="1">
            <Grid x:Name="Container">
                <ItemsControl x:Name="RecipesList" ItemsSource="{Binding Recipes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280" 
                                    Height="280" 
                                    Margin="10"
                                    Background="White">
                                <Grid>
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>